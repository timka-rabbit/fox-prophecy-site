---
interface ImageSource {
  desktop: string;
  mobile?: string;
}

interface Props {
  images: (string | ImageSource)[];
  productName?: string;
  showArrows?: boolean;
  arrowStyle?: 'default' | 'hero';
  arrowSpacing?: 'sm' | 'md' | 'lg';
  dotsSpacing?: 'sm' | 'md' | 'lg';
  className?: string;
  dotsClassName?: string;
}

const { 
  images, 
  productName = "Изображение", 
  showArrows = true, 
  arrowStyle = 'default', 
  arrowSpacing = 'md',
  dotsSpacing = 'md',
  className = "aspect-square rounded-lg bg-zinc-900",
  dotsClassName = ""
} = Astro.props;

const carouselId = `carousel-${Math.random().toString(36).substring(7)}`;

const normalizedImages = images.map(img => 
  typeof img === 'string' ? { desktop: img, mobile: img } : img
);

const spacingClasses = {
  sm: { left: 'left-1 md:left-2', right: 'right-1 md:right-2' },
  md: { left: 'left-3 md:left-8', right: 'right-3 md:right-8' },
  lg: { left: 'left-6 md:left-16', right: 'right-6 md:right-16' },
};

const dotsSpacingClasses = {
  sm: 'bottom-1',
  md: 'bottom-3',
  lg: 'bottom-5',
};

// Вычисляем ширину track и каждого слайда
const totalItems = normalizedImages.length + 2; // оригиналы + 2 клона
const trackWidth = totalItems * 100; // например, 400% для 2 слайдов
const slideWidth = 100 / totalItems; // например, 25% для 4 элементов
---

<div class={`carousel-container relative w-full overflow-hidden ${className} group`} id={carouselId}>
  <!-- Слайды -->
  <div class="carousel-track flex h-full" data-track style={`width: ${trackWidth}%`}>
    {normalizedImages.map((img, index) => (
      <div class="carousel-slide h-full relative flex-shrink-0" data-slide={index} style={`width: ${slideWidth}%`}>
        <img 
          src={img.mobile || img.desktop} 
          alt={`${productName} - фото ${index + 1} (моб.)`} 
          class="w-full h-full object-cover select-none md:hidden" 
          loading={index === 0 ? "eager" : "lazy"} 
          decoding="async" 
          draggable="false"
        />
        <img 
          src={img.desktop} 
          alt={`${productName} - фото ${index + 1} (деск.)`} 
          class="w-full h-full object-cover select-none hidden md:block" 
          loading={index === 0 ? "eager" : "lazy"} 
          decoding="async" 
          draggable="false"
        />
      </div>
    ))}
  </div>

  <!-- Стрелки -->
  {normalizedImages.length > 1 && showArrows && (
    <>
		<button 
		  class={`group/carousel-prev absolute flex items-center justify-center transition-all duration-300 z-20
			${arrowStyle === 'hero' 
			  ? `top-1/2 -translate-y-1/2 ${spacingClasses[arrowSpacing].left} w-16 h-20 opacity-0 group-hover:opacity-100 hover:scale-110` 
			  : 'top-1/2 -translate-y-1/2 left-3 w-9 h-9 rounded-full border border-white/30 bg-black/30 hover:bg-white hover:text-black text-white backdrop-blur-md opacity-0 group-hover:opacity-100'
			}`}
		  aria-label="Предыдущее фото"
		  data-prev
		>
		  {arrowStyle === 'hero' ? (
			<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-14 transition-all duration-300 group-hover/carousel-prev:stroke-white" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5" style="filter: drop-shadow(0 0 2px rgba(255,255,255,0.5));">
			  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
			</svg>
		  ) : (
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
			</svg>
		  )}
		</button>

		<button 
		  class={`group/carousel-next absolute flex items-center justify-center transition-all duration-300 z-20
			${arrowStyle === 'hero' 
			  ? `top-1/2 -translate-y-1/2 ${spacingClasses[arrowSpacing].right} w-16 h-20 opacity-0 group-hover:opacity-100 hover:scale-110` 
			  : 'top-1/2 -translate-y-1/2 right-3 w-9 h-9 rounded-full border border-white/30 bg-black/30 hover:bg-white hover:text-black text-white backdrop-blur-md opacity-0 group-hover:opacity-100'
			}`}
		  aria-label="Следующее фото"
		  data-next
		>
		  {arrowStyle === 'hero' ? (
			<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-14 transition-all duration-300 group-hover/carousel-next:stroke-white" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5" style="filter: drop-shadow(0 0 2px rgba(255,255,255,0.5));">
			  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
			</svg>
		  ) : (
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
			</svg>
		  )}
		</button>
    </>
  )}

  <!-- Индикаторы (точки) -->
  {normalizedImages.length > 1 && (
    <div class={`carousel-dots absolute flex gap-2 z-30 px-3 py-1.5 rounded-full bg-black/20 backdrop-blur-sm border border-white/10 left-1/2 -translate-x-1/2 ${dotsClassName || dotsSpacingClasses[dotsSpacing]} opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300`} data-dots>
      {normalizedImages.map((_, index) => (
        <button 
          class={`dot w-2 h-2 rounded-full transition-all ${index === 0 ? 'bg-white w-6' : 'bg-white/60 hover:bg-white'}`}
          aria-label={`Перейти к фото ${index + 1}`}
          data-dot={index}
        ></button>
      ))}
    </div>
  )}
</div>

<script client:visible>
  document.querySelectorAll('.carousel-container').forEach((container) => {
    const track = container.querySelector('[data-track]');
    const prevBtn = container.querySelector('[data-prev]');
    const nextBtn = container.querySelector('[data-next]');
    const dots = container.querySelectorAll('[data-dot]');
    
    if (!track || dots.length < 2) return;
    
    const originalSlides = Array.from(track.children);
    const totalSlides = originalSlides.length;
    
    // Клонируем первый и последний слайд
    const firstClone = originalSlides[0].cloneNode(true);
    const lastClone = originalSlides[totalSlides - 1].cloneNode(true);
    
    firstClone.setAttribute('data-clone', 'first');
    lastClone.setAttribute('data-clone', 'last');
    
    track.appendChild(firstClone);
    track.insertBefore(lastClone, originalSlides[0]);
    
    // Пересчитываем ширину track и слайдов после добавления клонов
    const totalItems = track.children.length;
    const slideWidthPercent = 100 / totalItems;
    
    Array.from(track.children).forEach(slide => {
      slide.style.width = `${slideWidthPercent}%`;
    });
    
    track.style.width = `${totalItems * 100}%`;
    
    let currentIndex = 1;
    let isTransitioning = false;

    const updateCarousel = (instant = false) => {
      if (instant) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 500ms ease-out';
      }
      track.style.transform = `translateX(-${currentIndex * slideWidthPercent}%)`;
      
      const realIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      dots.forEach((dot, i) => {
        if (i === realIndex) {
          dot.classList.remove('bg-white/60', 'w-2');
          dot.classList.add('bg-white', 'w-6');
        } else {
          dot.classList.remove('bg-white', 'w-6');
          dot.classList.add('bg-white/60', 'w-2');
        }
      });
    };

    track.addEventListener('transitionend', () => {
      if (currentIndex === 0) {
        currentIndex = totalSlides;
        updateCarousel(true);
      } else if (currentIndex === totalSlides + 1) {
        currentIndex = 1;
        updateCarousel(true);
      }
      isTransitioning = false;
    });

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex--;
        updateCarousel(false);
      });
    }
    
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex++;
        updateCarousel(false);
      });
    }
    
    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex = i + 1;
        updateCarousel(false);
      });
    });

    let touchStartX = 0;
    let touchEndX = 0;
    
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    container.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (isTransitioning) return;
        isTransitioning = true;
        if (diff > 0) {
          currentIndex++;
        } else {
          currentIndex--;
        }
        updateCarousel(false);
      }
    }, { passive: true });

    updateCarousel(true);
  });
</script>