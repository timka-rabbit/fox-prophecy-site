---

<footer class="bg-zinc-950 border-t border-zinc-900 py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-12 mb-12">
      
      <!-- Колонка 1: О группе (теперь по центру) -->
      <div class="text-center">
        <h3 class="text-lg font-bold mb-4 font-['Space_Grotesk']">Fox Prophecy</h3>
        <p class="text-sm text-zinc-500 leading-relaxed">
          Сольный метал-проект Буянова Артёма Дмитриевича в поджанрах альтернативный метал, металкор и пост-хардкор.
        </p>
      </div>

      <!-- Колонка 2: Контакты (по центру, заголовок в едином стиле) -->
      <div class="text-center">
        <h3 class="text-lg font-bold mb-4 font-['Space_Grotesk']">Контакты</h3>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${contactEmail}`} class="text-zinc-300 hover:text-white transition-colors flex items-center justify-center gap-3 group">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-zinc-500 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="text-sm">{contactEmail}</span>
            </a>
          </li>
          {socialLinks.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white transition-colors flex items-center justify-center gap-3 group">
                <span class="w-5 h-5 text-zinc-500 group-hover:text-white transition-colors" set:html={social.icon} />
                <span class="text-sm">{social.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Колонка 3: Странички музыканта (по центру, заголовок в едином стиле) -->
      <div class="text-center">
        <h3 class="text-lg font-bold mb-4 font-['Space_Grotesk']">Странички музыканта</h3>
        <ul class="space-y-3">
          {musicPlatforms.map((platform) => (
            <li>
              <a href={platform.url} target="_blank" rel="noopener noreferrer" class="text-zinc-300 hover:text-white transition-colors flex items-center justify-center gap-3 group">
                <span class="w-5 h-5 text-zinc-500 group-hover:text-white transition-colors" set:html={platform.icon} />
                <span class="text-sm">{platform.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Копирайт -->
    <div class="pt-8 border-t border-zinc-900 text-center text-xs text-zinc-600">
      <p>© {new Date().getFullYear()} Fox Prophecy. Все права защищены.</p>
    </div>
  </div>
</footer>