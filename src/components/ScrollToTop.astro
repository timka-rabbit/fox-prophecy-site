<button
  id="scrollToTopBtn"
  class="fixed bottom-6 right-6 z-50 p-3 bg-white text-black rounded-full shadow-xl opacity-0 invisible translate-y-4 transition-all duration-300 hover:bg-zinc-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-zinc-950"
  aria-label="Вернуться наверх"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  const btn = document.getElementById('scrollToTopBtn');

  // Показываем/скрываем кнопку при скролле
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) { // Появляется после 400px прокрутки
      btn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
      btn.classList.add('opacity-100', 'visible', 'translate-y-0');
    } else {
      btn.classList.remove('opacity-100', 'visible', 'translate-y-0');
      btn.classList.add('opacity-0', 'invisible', 'translate-y-4');
    }
  });

  // Плавный скролл наверх при клике
  btn.addEventListener('click', () => {
    window.scrollTo({ 
      top: 0, 
      behavior: 'smooth' 
    });
  });
</script>