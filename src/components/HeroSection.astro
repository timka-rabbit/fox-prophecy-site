---
interface Props {
  artistName: string;
  heroImage: string;
  heroImageMobile?: string;
}

const { artistName, heroImage, heroImageMobile } = Astro.props;

const mobileImage = heroImageMobile || heroImage;

const navLinks = [
  { label: 'Об исполнителе', href: '#about' },
  { label: 'Дискография', href: '#discography' },
  { label: 'Мерч', href: '#merch' },
];
---

<section class="relative flex flex-col">
  <div class="relative flex flex-col md:flex-row">

    <!-- Текст и кнопки -->
    <!-- Мобильная версия: снизу, десктоп: слева -->
    <div class="order-2 md:order-1 md:w-1/2 flex flex-col justify-center px-6 md:px-16 lg:px-24 py-12 md:py-0 z-10">
      <div class="space-y-6 md:space-y-8">

        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.9] text-center md:text-left">
          {artistName}
        </h1>

        <p class="text-lg md:text-2xl text-zinc-400 max-w-xl leading-relaxed text-center md:text-left">
          Космический альбом Dark Matter уже доступен
        </p>

        <div class="flex flex-col md:flex-row gap-3 md:gap-4 pt-2 md:pt-4 w-full md:w-auto max-w-sm md:max-w-none mx-auto md:mx-0">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="w-full md:w-auto px-6 py-3 bg-white text-black font-medium rounded-full hover:bg-zinc-200 transition-colors text-center"
            >
              {link.label}
            </a>
          ))}
        </div>

      </div>
    </div>

    <!-- Фото -->
    <!-- Мобильная версия: сверху, десктоп: справа -->
    <div class="order-1 md:order-2 md:w-1/2 relative">

      <!-- Мобильное фото -->
      <img
        src={mobileImage}
        alt={artistName}
        class="w-full aspect-square object-cover md:hidden"
        loading="eager"
      />

      <!-- Десктопное фото -->
      <img
        src={heroImage}
        alt={artistName}
        class="hidden md:block w-full aspect-square object-cover"
        loading="eager"
      />

      <!-- Градиент снизу для мобильных -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-zinc-950 md:hidden" />

      <!-- Градиент слева для десктопа (переход от текста к фото) -->
      <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/50 to-transparent md:block hidden z-10" />
    
      <!-- Градиент снизу для десктопа (плавное растворение фото внизу) -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-zinc-950 md:block hidden z-10" />

    </div>

  </div>
</section>