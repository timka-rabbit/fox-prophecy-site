---
interface Props {
  artistName: string;
  heroImage: string;
}
const { artistName, heroImage } = Astro.props;

const navLinks = [
  { label: 'Об исполнителе', href: '#about' },
  { label: 'Дискография', href: '#discography' },
  { label: 'Мерч', href: '#merch' },
];
---
<section class="relative min-h-screen flex flex-col">
  <div class="relative flex-1 flex flex-col md:flex-row">
    <div class="md:w-1/2 flex flex-col justify-center px-6 md:px-16 lg:px-24 py-32 md:py-0 z-10">
      <div class="space-y-6">
        <h1 class="text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9]">{artistName}</h1>
        
        <p class="text-xl md:text-2xl text-zinc-400 max-w-xl leading-relaxed">Космический альбом Dark Matter уже доступен</p>
        
        <!-- Все три кнопки белые -->
        <div class="flex gap-4 pt-4 flex-wrap">
          <a href="#about" class="px-6 py-3 bg-white text-black font-medium rounded-full hover:bg-zinc-200 transition-colors">Об исполнителе</a>
          <a href="#discography" class="px-6 py-3 bg-white text-black font-medium rounded-full hover:bg-zinc-200 transition-colors">Дискография</a>
          <a href="#merch" class="px-6 py-3 bg-white text-black font-medium rounded-full hover:bg-zinc-200 transition-colors">Мерч</a>
        </div>
      </div>
    </div>
    <div class="md:w-1/2 relative">
      <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/50 to-transparent md:block hidden z-10" />
      <img src={heroImage} alt={artistName} class="w-full h-full object-cover" loading="eager" />
    </div>
  </div>
</section>