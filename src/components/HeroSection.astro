---
import ImageCarousel from './ImageCarousel.astro';

interface Props {
  artistName: string;
  images: (string | { desktop: string; mobile?: string })[];
}

const { artistName, images } = Astro.props;

const navLinks = [
  { label: 'Об исполнителе', href: '#about' },
  { label: 'Дискография', href: '#discography' },
  { label: 'Мерч', href: '#merch' },
];
---

<section class="relative flex flex-col">
  <div class="relative flex flex-col md:flex-row">

    <!-- Текст и кнопки -->
    <div class="order-2 md:order-1 md:w-1/2 flex flex-col justify-center px-6 md:px-16 lg:px-24 py-12 md:py-0 z-20">
      <div class="space-y-6 md:space-y-8">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.9] text-center md:text-left">
          {artistName}
        </h1>

        <p class="text-lg md:text-2xl text-zinc-400 max-w-xl leading-relaxed text-center md:text-left">
          Космический альбом Dark Matter уже доступен
        </p>

        <div class="flex flex-col md:flex-row gap-3 md:gap-4 pt-2 md:pt-4 w-full md:w-auto max-w-sm md:max-w-none mx-auto md:mx-0">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="w-full md:w-auto px-6 py-3 bg-white text-black font-medium rounded-full hover:bg-zinc-200 transition-colors text-center"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Карусель -->
    <div class="order-1 md:order-2 md:w-1/2 relative">
      
	  <ImageCarousel 
	    images={images} 
	    productName={artistName}
	    showArrows={true}
	    arrowStyle="hero" 
	    arrowSpacing="sm"
		dotsSpacing="sm"
	    className="w-full h-full md:aspect-auto md:h-auto"
	    dotsClassName="bottom-4 left-1/2 -translate-x-1/2"
	  />
      
      <!-- Градиенты -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-zinc-950 md:hidden z-10 pointer-events-none" />
      <div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/50 to-transparent md:block hidden z-10 pointer-events-none" />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-zinc-950 md:block hidden z-10 pointer-events-none" />

    </div>

  </div>
</section>