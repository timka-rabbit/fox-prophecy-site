---
interface Props {
  productName: string;
  price: number;
  googleFormUrl: string;
  modalId: string;
}

const { productName, price, googleFormUrl, modalId } = Astro.props;
---

<div class="modal hidden fixed inset-0 z-50 overflow-y-auto group" id={modalId}>
  <div class="modal-backdrop absolute inset-0 bg-black/80 backdrop-blur-sm" data-close-modal></div>
  
  <div class="relative min-h-screen flex items-center justify-center p-4">
    <div class="modal-content relative bg-zinc-950 border border-zinc-800 rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
      
      <!-- Кнопка закрытия -->
      <button 
        class="absolute top-4 right-4 w-10 h-10 rounded-full border border-white/30 bg-black/30 hover:bg-white hover:text-black text-white backdrop-blur-md transition-all duration-300 hover:rotate-90 flex items-center justify-center z-10"
        data-close-modal
        aria-label="Закрыть"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Шапка -->
      <div class="p-6 border-b border-zinc-800">
        <h3 class="text-2xl font-bold">Заказ: {productName}</h3>
        <p class="text-zinc-400 mt-1">Стоимость: <span class="text-white font-mono">{price} ₽</span></p>
      </div>

      <div class="p-6 space-y-4">
        <!-- Инструкция -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-4">
          <div class="flex items-start gap-3">
            <span class="text-2xl">📋</span>
            <div>
              <h4 class="font-semibold text-white mb-1">Как оформить заказ</h4>
              <ol class="text-sm text-zinc-400 space-y-1 list-decimal list-inside">
                <li>Заполните все обязательные поля в форме ниже (отмечены *)</li>
                <li>Нажмите кнопку <strong class="text-white">"Отправить"</strong> в форме</li>
                <li>После отправки появится ссылка на оплату — перейдите по ней</li>
                <li>Оплатите заказ удобным способом</li>
              </ol>
            </div>
          </div>
        </div>

        <!-- Форма и юридическое согласие -->
        <div>
          <!-- Ссылка на оферту с параметром ?from=order -->
          <p class="text-xs text-zinc-500 mb-3">
            Нажимая кнопку «Отправить» в форме ниже, вы автоматически соглашаетесь с условиями <a href="/legal?from=order" class="text-zinc-300 underline hover:text-white transition-colors">Публичной оферты</a>.
          </p>

          <div class="rounded-lg overflow-hidden border border-zinc-800 bg-white">
            <iframe 
              src={googleFormUrl}
              class="w-full h-[600px] border-0"
              title="Форма заказа"
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <!-- Предупреждение -->
        <div class="bg-yellow-900/20 border border-yellow-800/50 rounded-lg p-4">
          <div class="flex items-start gap-3">
            <span class="text-yellow-500 text-xl">⚠️</span>
            <div>
              <p class="text-sm text-yellow-200 font-medium mb-1">Важно!</p>
              <p class="text-sm text-yellow-100/80">
                Ссылка на оплату появится <strong>только после успешной отправки формы</strong>. 
                Если вы не заполните обязательные поля, форма не отправится и ссылка не появится.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>